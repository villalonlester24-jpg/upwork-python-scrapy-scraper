# ZenRows scraping API (https://www.zenrows.com/register)
ZENROWS_API_KEY=your-zenrows-api-key
# Leave empty to force js_render + premium_proxy (Upwork needs this to render).
ZENROWS_MODE=
# Extra ms to wait for the JS-rendered job list.
ZENROWS_WAIT=5000

# Optional Upwork session cookie for login-only fields. Not needed for the
# public search spider.
UPWORK_COOKIE=

# Concurrency: keep 1 on the ZenRows free plan (higher causes HTTP 429).
CONCURRENT_REQUESTS=1
